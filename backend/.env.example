# Archivo exclusivamente documental. No copies secretos aquí ni crees un .env.
# Configura la contraseña por entorno con Wrangler:
# pnpm exec wrangler secret put ADMIN_PASSWORD --env preview
# pnpm exec wrangler secret put ADMIN_PASSWORD --env production
ADMIN_PASSWORD=<CONFIGURAR_COMO_SECRETO_DE_CLOUDFLARE>
